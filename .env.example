# Appwrite Configuration (Client & Public)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=6a9b4399000ba2817e08
NEXT_PUBLIC_APPWRITE_DATABASE_ID=6aa0a8f00015379a297f
APPWRITE_STORAGE_ID=6aa10cbe000dad323c41
NEXT_PUBLIC_APPWRITE_COLLECTION_PRODUCTS=products
NEXT_PUBLIC_APPWRITE_COLLECTION_ORDERS=orders
NEXT_PUBLIC_APPWRITE_COLLECTION_USERS=users
NEXT_PUBLIC_APPWRITE_COLLECTION_FILES=product_files
NEXT_PUBLIC_APPWRITE_COLLECTION_PURCHASES=purchases

# Appwrite Server API Key (Netlify Functions Server-Side ONLY)
APPWRITE_API_KEY=

# SebPay Production Payment Provider (Netlify Functions Server-Side ONLY - Never expose in browser)
# Production public key (begins with pk_live_...)
SEBPAY_PUBLIC_KEY=pk_live_
# Production secret key (begins with sk_live_... - STRICTLY CONFIDENTIAL)
SEBPAY_SECRET_KEY=sk_live_
# Production SebPay API base URL
SEBPAY_API_URL=https://newapi.sebpay.bj/api/v1
# Marketplace Currency (e.g. XOF for West Africa CFA Francs, or USD)
MARKETPLACE_CURRENCY=XOF
# Exchange rate from USD to XOF if products are denominated in USD (e.g. 1 USD ~ 600 XOF)
USD_TO_XOF_RATE=600
